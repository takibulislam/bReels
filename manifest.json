{
  "manifest_version": 3,
  "name": "Personal Assistant",
  "version": "2.1",
  "description": "Block distractions and boost productivity on social media and Upwork.",
  "permissions": ["storage", "scripting", "tabs"],
  "host_permissions": [
    "*://*.facebook.com/*",
    "*://*.instagram.com/*",
    "*://*.youtube.com/*",
    "*://*.upwork.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Personal Assistant Settings",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.facebook.com/*",
        "*://*.instagram.com/*",
        "*://*.youtube.com/*",
        "*://*.upwork.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
